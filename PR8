// ==========================================================
// Question 1: Sessions
// ==========================================================
session_start();
$_SESSION['username'] = 'Student';
echo 'Welcome ' . htmlspecialchars($_SESSION['username']) . '<br>';


// ==========================================================
// Question 2: Cookies
// ==========================================================
setcookie('visitor', 'Student', time() + 3600, '/');
echo 'Cookie has been set. Refresh the page to read it.<br>';


// ==========================================================
// Question 3: Validate Input with Filters
// ==========================================================
$email = filter_input(INPUT_POST, 'email', FILTER_VALIDATE_EMAIL);
if ($email) {
    echo 'Valid email: ' . htmlspecialchars($email);
} else {
    echo 'Please enter a valid email.';
}
?>

