<?php
session_start();
$notice = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $email = filter_input(INPUT_POST, 'email', FILTER_VALIDATE_EMAIL);
    $name = trim($_POST['name'] ?? '');

    if ($name === '') {
        $notice = 'Name is required.';
    } elseif (!$email) {
        $notice = 'Please enter a valid email address.';
    } else {
        $_SESSION['username'] = $name;
        setcookie('visitor', $name, time() + 3600, '/');
        $notice = 'Input accepted. Session and cookie updated.';
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PHP Sessions Cookies Filters</title>
</head>
<body>
    <h1>Session, Cookie and Filter Demo</h1>

    <?php if ($notice): ?>
        <p style="color: blue;"><strong><?php echo htmlspecialchars($notice); ?></strong></p>
    <?php endif; ?>

    <form method="post" action="">
        <label>Name: <input type="text" name="name" required></label><br><br>
        <label>Email: <input type="email" name="email" required></label><br><br>
        <button type="submit">Submit</button>
    </form>

    <h2>Current Session</h2>
    <p>
        <?php 
        echo isset($_SESSION['username']) 
            ? 'Logged in as: ' . htmlspecialchars($_SESSION['username']) 
            : 'No session name yet.'; 
        ?>
    </p>

    <h2>Cookie</h2>
    <p>
        <?php 
        echo isset($_COOKIE['visitor']) 
            ? 'Cookie visitor: ' . htmlspecialchars($_COOKIE['visitor']) 
            : 'Cookie will be available after the next request / page refresh.'; 
        ?>
    </p>
</body>
</html>
